# ─── Base de données Neon (PostgreSQL) ───────────────────────────────
# Chaîne "pooled" (avec -pooler) pour l'application
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/scar?sslmode=require"
# Chaîne directe (sans -pooler) pour les migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/scar?sslmode=require"

# ─── Auth.js ─────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Fournisseurs de connexion (laisser vide pour désactiver un bouton)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""
AUTH_TIKTOK_ID=""
AUTH_TIKTOK_SECRET=""
AUTH_INSTAGRAM_ID=""
AUTH_INSTAGRAM_SECRET=""

# ─── Resend (emails) ─────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Dizy Cars <reservations@votre-domaine.ma>"

# ─── Cloudinary (photos des voitures, pièces d'identité) ─────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Application ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Premier administrateur créé par `npm run db:seed`
SEED_ADMIN_EMAIL="admin@dizycars.com"
SEED_ADMIN_PASSWORD="ChangezMoi!2026"
